# Names only, no values (Д-§7). Real values live in the GitHub Environment `production`.
ENV=
LOG_LEVEL=
POSTGRES_DSN=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
REDIS_URL=
COMPUTE_URL=
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# JSON of model prices, dollars per 1M tokens (D-B-198); empty is fine in dev and test.
LLM_PRICES=
# D-B-211: pool of dollars for the models, 0 means off.
LLM_POOL_BUDGET_USD=0
# Empty means tracing off (D-B-201).
LANGSMITH_API_KEY=
# Sign-in (WP18). Cookie domain: `localhost` for a local stack (the browser drops a cookie whose
# domain is `qvack.online`); the server uses `qvack.online`.
SESSION_COOKIE_DOMAIN=localhost
# Where sign-in returns the browser; empty means sign-in does not redirect (D-C-105).
AUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/
# Version of the terms text the consent screen shows (Т-§19.4).
TERMS_VERSION=
# Resend key and Google sign-in client: secrets, leave empty unless you test the real service.
EMAIL_API_KEY=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
# Learner objects (Contabo, path-style S3, Д-§8.4); bucket name has a default.
S3_BUCKET_LEARNERS=quack-learners
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Deletions journal (R2, bucket quack-deletions, Д-§8.5): https://<account>.r2.cloudflarestorage.com
# Empty endpoint means deletions answer 503 (the journal cannot be written).
DELETIONS_S3_ENDPOINT=
DELETIONS_S3_ACCESS_KEY=
DELETIONS_S3_SECRET_KEY=
